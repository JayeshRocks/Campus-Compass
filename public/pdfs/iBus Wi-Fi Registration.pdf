    <script type="text/javascript">

        function isValidPhoneJS(v) {
            v = v.trim();
            return /^[0-9]{10}$/.test(v);
        }
        function isValidEmailJS(v) {
            v = v.trim();
            if (v.length > 100) return false;
            var pattern = /^[a-zA-Z0-9](?:[a-zA-Z0-9._%+-]*[a-zA-Z0-9])?@[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?)+$/;
            return pattern.test(v);
        }
        function validatePhoneOnBlur(el, errId) {
            var errEl = document.getElementById(errId);
            var val = el.value.trim();
            if (val === '') { errEl.style.display = 'none'; return; }
            if (!isValidPhoneJS(val)) {
                errEl.textContent = 'Enter a valid 10-digit number';
                errEl.style.display = 'block';
            } else {
                errEl.style.display = 'none';
            }
        }
        function validateEmailOnBlur(el, errId) {
            var errEl = document.getElementById(errId);
            var val = el.value.trim();
            if (val === '') { errEl.style.display = 'none'; return; }
            if (!isValidEmailJS(val)) {
                errEl.textContent = 'Enter a valid email address';
                errEl.style.display = 'block';
            } else {
                errEl.style.display = 'none';
            }
        }

        function toggleHobbyRow(radioEl, isYes) {
            if (radioEl.disabled) return;
            var row = radioEl.closest('tr');
            if (!row || !row.cells || row.cells.length < 7) return;
            var targetCells = [row.cells[3], row.cells[4], row.cells[5], row.cells[6]];
            targetCells.forEach(function (cell) {
                var el = cell.querySelector('input');
                if (!el) return;
                el.disabled = !isYes;
                if (!isYes) {
                    if (el.type === 'radio') el.checked = false;
                    else el.value = '';
                }
            });
        }

        function confirmSubmit() {
            Swal.fire({
                title: 'Confirm Submission',
                text: 'Once submitted, the form cannot be edited. Are you sure you want to submit?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, Submit',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    showLoadingOverlay();
                    document.getElementById('ContentPlaceHolder1_btnSubmit').disabled = true;
                    __doPostBack('ctl00$ContentPlaceHolder1$btnSubmit', '');
                }
            });
            return false;
        }

        function showLoadingOverlay() {
            document.getElementById('obLoadingOverlay').style.display = 'block';
        }

        var sys = window.Sys;
        if (sys && sys.WebForms && sys.WebForms.PageRequestManager) {
            sys.WebForms.PageRequestManager.getInstance().add_endRequest(function () {
                document.getElementById('obLoadingOverlay').style.display = 'none';
                syncHobbyRowStates();
            });
        }

        function syncHobbyRowStates() {
            document.querySelectorAll('#tblHobbies tbody tr').forEach(function (row) {
                var yesRadio = row.querySelector('input[type="radio"][id*="rbYes"]');
                var noRadio = row.querySelector('input[type="radio"][id*="rbNo"]');
                if (yesRadio) {
                    toggleHobbyRow(yesRadio, yesRadio.checked);
                } else if (noRadio) {
                    toggleHobbyRow(noRadio, false);
                }
            });
        }

        document.addEventListener('DOMContentLoaded', syncHobbyRowStates);

        function showUndertakingModal() {
            var modalEl = document.getElementById('undertakingModal');
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        }

        function closeUndertakingModal() {
            var modalEl = document.getElementById('undertakingModal');
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.hide();
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


  
    </form>
