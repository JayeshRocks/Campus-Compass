    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

       <style>
        body { background: #f4f6fb; }

        .ob-card {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 3px 12px rgba(44,62,80,0.08);
            margin-bottom: 16px;
            border: none;
        }

        .ob-card-header {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            border-radius: 10px 10px 0 0;
            padding: 12px 18px;
            color: #fff;
            font-size: 1rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .ob-card-body { padding: 16px 18px; }

        .ob-section {
            background: #f8f9fb;
            border: 1px solid #e3e6f0;
            border-radius: 8px;
            padding: 14px 16px;
            margin-bottom: 14px;
        }

        .ob-section-title {
            font-size: 0.88rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 6px;
            border-bottom: 2px solid #e3e6f0;
            padding-bottom: 6px;
        }

        .ob-section-title i { color: #3498db; font-size: 0.82rem; }
        .ob-section-title .opt-tag {
            font-size: 0.66rem;
            font-weight: 600;
            color: #6c757d;
            background: #eceff3;
            padding: 1px 8px;
            border-radius: 8px;
            margin-left: 4px;
        }

        /* uniform gutter everywhere - no leftover mb-3 stacking issues */
        .ob-section .row {
            row-gap: 12px;
            column-gap: 0;
        }
        .ob-section .row > [class^="col-"] { margin-bottom: 0 !important; }

        .form-label {
            font-weight: 500;
            color: #495057;
            font-size: 0.78rem;
            margin-bottom: 3px;
            display: block;
        }

        .form-label .req { color: #e74c3c; margin-left: 2px; }
        .form-label .opt { color: #9aa3ab; font-size: 0.72rem; font-weight: 400; margin-left: 3px; }

        .form-control, .form-select {
            border-radius: 5px;
            font-size: 0.82rem;
            border: 1px solid #ced4da;
            padding: 5px 10px;
            height: 34px;
            width: 100%;
        }

        textarea.form-control {
            height: auto;
            min-height: 46px;
            padding: 6px 10px;
            resize: vertical;
        }

        .form-control:focus, .form-select:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.12rem rgba(52,152,219,0.18);
        }

        .readonly-field {
            background: #f0f3f7 !important;
            color: #555 !important;
            cursor: not-allowed;
        }

        .ob-roll-badge {
            background: #e8f4fb;
            border: 1px solid #b3d7ee;
            border-radius: 7px;
            padding: 6px 14px;
            font-size: 0.88rem;
            font-weight: 600;
            color: #2c3e50;
            display: inline-block;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 16px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .status-draft { background: #fef3cd; color: #856404; }
        .status-submitted { background: #d1ecf1; color: #0c5460; }
        .status-confirmed { background: #d4edda; color: #155724; }

        .doc-row {
    display: grid;
    grid-template-columns: 1fr 160px 130px;
    align-items: center;
    column-gap: 8px;
    padding: 8px 0;
    border-bottom: 1px solid #e3e6f0;
    font-size: 0.85rem;
}
.doc-row:last-child { border-bottom: none; }

.doc-row .doc-actions {
    display: contents;
}

.doc-row .doc-actions .btn {
    white-space: nowrap;
    width: 100%;
}
        .mandatory-pill {
            font-size: 0.66rem;
            font-weight: 600;
            padding: 2px 8px;
            border-radius: 8px;
            margin-left: 6px;
        }
        .mandatory-yes { background: #fde2e1; color: #c0392b; }
        .mandatory-no { background: #eceff3; color: #6c757d; }

        .btn-ob-primary {
            background: linear-gradient(135deg, #2c3e50 0%, #3498db 100%);
            color: #fff;
            border: none;
            border-radius: 18px;
            padding: 7px 20px;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.2s;
        }
        .btn-ob-primary:hover { opacity: 0.9; color: #fff; }

        .btn-ob-secondary {
            background: #6c757d;
            color: #fff;
            border: none;
            border-radius: 18px;
            padding: 7px 20px;
            font-weight: 600;
            font-size: 0.85rem;
        }

        .btn-ob-download {
            background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%);
            color: #fff;
            border: none;
            border-radius: 18px;
            padding: 8px 22px;
            font-weight: 600;
            font-size: 0.87rem;
        }

        .upload-area {
            border: 2px dashed #b3d7ee;
            border-radius: 8px;
            padding: 12px;
            background: #f8fbff;
        }

        .ob-loading-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(255,255,255,0.6);
            z-index: 9999;
            text-align: center;
        }
        .ob-loading-overlay .spinner-border { margin-top: 25vh; }

        .field-error {
            display: none;
            color: #e74c3c;
            font-size: 0.72rem;
            margin-top: 2px;
        }

        #tblHobbies { font-size: 0.82rem; }
        #tblHobbies th, #tblHobbies td { padding: 5px 7px; vertical-align: middle; }
        #tblHobbies .form-control-sm { height: 30px; font-size: 0.8rem; }
    </style>

